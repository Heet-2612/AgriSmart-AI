DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/agrismart_db
MODEL_CHECKPOINT_PATH=model/checkpoints/best_model.pt
MODEL_VERSION=v0.1.0-scaffold
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here
